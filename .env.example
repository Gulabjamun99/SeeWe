# SeeWe AI Recruitment Portal - Environment Variables

# Database: SQLite path relative to prisma/schema.prisma (works out of the box with pre-seeded data)
DATABASE_URL="file:../db/custom.db"

# Optional: Google Gemini API (Free tier supported)
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-1.5-flash"

# Optional: OpenAI / Groq / OpenAI-compatible provider
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Note: If no AI API keys are set, SeeWe runs in offline smart fallback mode
# so you can test all UI flows, interviews, and candidate search with zero external dependencies!
